  "nodes": [
    {
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Enviar convênios",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "b4c1e1f0-1a10-4c0a-9a10-000000000001",
      "parameters": {
        "formTitle": "Base de convênios",
        "formDescription": "Envie os PDFs dos convênios. O envio substitui a base anterior.",
        "formFields": {
          "values": [
            {
              "fieldName": "documentos",
              "fieldLabel": "Documentos",
              "fieldType": "file",
              "multipleFiles": true,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "base-convenios"
        }
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Um item por arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// O formulário entrega todos os PDFs num único item (Documentos_0, Documentos_1, ...).\n// Aqui cada arquivo vira um item, com o binário em \"data\" e o nome do arquivo no JSON.\nconst saida = [];\nfor (const item of $input.all()) {\n  for (const chave of Object.keys(item.binary ?? {})) {\n    const arquivo = item.binary[chave];\n    saida.push({ json: { arquivo: arquivo.fileName }, binary: { data: arquivo } });\n  }\n}\nreturn saida;"
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Extrair texto",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Inserir na base",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreInMemory",
      "typeVersion": 1.3,
      "position": [
        680,
        0
      ],
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "__rl": true,
          "mode": "list",
          "value": "convenios",
          "cachedResultName": "convenios"
        },
        "embeddingBatchSize": 50,
        "clearStore": true
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Base atualizada",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        960,
        0
      ],
      "webhookId": "b4c1e1f0-1a10-4c0a-9a10-000000000002",
      "parameters": {
        "operation": "completion",
        "completionTitle": "Base atualizada",
        "completionMessage": "={{ $('Um item por arquivo').all().length }} arquivo(s) indexado(s) em {{ $input.all().length }} trecho(s).",
        "options": {}
      }
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [
